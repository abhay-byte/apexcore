<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ApexCore.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ApexCore</item>
    </style>
    <style name="Theme.ApexCore" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.App" parent="Theme.ApexCore.Splash" />
</resources>
