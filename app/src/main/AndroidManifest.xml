<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <provider android:authorities="moe.shizuku.privileged.api.provider" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:label="ApexCore"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.ApexCore.Splash">
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.ApexCore.Splash"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden" />

        <!-- Theme-aware launcher icons: Graphite (dark) vs Vellum (light). Exactly one enabled. -->
        <activity-alias
            android:name=".LauncherGraphite"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="ApexCore"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherVellum"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_vellum"
            android:roundIcon="@mipmap/ic_launcher_vellum_round"
            android:label="ApexCore"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false" />

        <receiver
            android:name=".freeze.FreezeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ivarna.apexcore.action.FREEZE_ALL" />
            </intent-filter>
        </receiver>

        <service
            android:name=".games.GameOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Draggable performance HUD to monitor game stats (FPS, RAM, CPU) and trigger memory boost during gameplay." />
        </service>
        <service
            android:name=".ram.RamFillerService"
            android:exported="false"
            android:process=":ramfiller" />

    </application>
</manifest>
